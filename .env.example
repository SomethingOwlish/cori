# Firebase / Firestore configuration.
#
# Copy this file to `.env.local` and fill in the values from your Firebase
# project settings (Project settings → General → Your apps → SDK setup).
# All keys are read by `src/data/firestore/firebaseApp.ts` via Vite's
# `import.meta.env`. The `VITE_` prefix is required for the browser build.
#
# These are client-side identifiers, not secrets — access is governed by
# Firestore security rules, not by hiding the config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
